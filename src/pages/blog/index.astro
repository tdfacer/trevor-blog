---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="Blog posts about technology, programming, and more.">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
        <span class="text-terminal-green">$</span> cat blog/*
      </h1>
      <p class="text-terminal-muted font-mono">
        Thoughts, updates, and musings.
      </p>
    </header>

    {sortedPosts.length > 0 ? (
      <div class="grid md:grid-cols-2 gap-6">
        {sortedPosts.map((post) => (
          <PostCard
            title={post.data.title}
            href={`/blog/${post.id}`}
            date={post.data.date}
            description={post.data.description}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="text-terminal-muted text-center py-12">No posts yet. Check back soon!</p>
    )}
  </div>
</BaseLayout>
