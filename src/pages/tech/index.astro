---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryCard from '../../components/ui/CategoryCard.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('tech', ({ data }) => !data.draft);

// Group by category
const categories = articles.reduce((acc, article) => {
  const cat = article.data.category;
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categoryIcons: Record<string, string> = {
  ai: '🤖',
  linux: '🐧',
  aws: '☁️',
  neovim: '📝',
  git: '🌿',
  devops: '⚙️',
  networking: '🌐',
  web: '🕸️',
  misc: '📦',
};

const categoryOrder = ['linux', 'aws', 'neovim', 'git', 'devops', 'ai', 'networking', 'web', 'misc'];
const sortedCategories = categoryOrder.filter(cat => categories[cat]);
---

<BaseLayout title="Tech" description="Technical articles about Linux, AWS, Neovim, and more.">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
        <span class="text-terminal-green">$</span> ls -la tech/
      </h1>
      <p class="text-terminal-muted font-mono">
        Technical articles organized by topic.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
      {sortedCategories.map((category) => (
        <CategoryCard
          title={category.charAt(0).toUpperCase() + category.slice(1)}
          href={`/tech/${category}`}
          count={categories[category]}
          icon={categoryIcons[category] || '>'}
        />
      ))}
    </div>
  </div>
</BaseLayout>
