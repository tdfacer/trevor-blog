---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Not Found">
  <div class="max-w-5xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold font-mono text-terminal-green mb-4">404</h1>
    <p class="text-xl text-terminal-muted mb-8 font-mono">
      $ file not found
    </p>
    <p class="text-terminal-text mb-8">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="inline-block px-6 py-3 bg-terminal-green text-terminal-bg font-mono font-semibold rounded hover:bg-terminal-green-dim transition-colors"
    >
      cd ~
    </a>
  </div>
</BaseLayout>
