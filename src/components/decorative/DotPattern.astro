---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['absolute inset-0 overflow-hidden pointer-events-none', className]}>
  <svg class="absolute w-full h-full opacity-30" aria-hidden="true">
    <defs>
      <pattern id="dot-pattern" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1" fill="currentColor" class="text-terminal-green" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#dot-pattern)" />
  </svg>
</div>
